{
  "name": "tennis-scoring",
  "private": true,
  "version": "1.1.0",
  "packageManager": "pnpm@9.15.5",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "test:shared": "pnpm --filter @tennis/shared test",
    "backfill:season-level": "node scripts/backfill-division-season-level.mjs --",
    "backfill:profiles": "node scripts/backfill-profiles.mjs --",
    "check:firebase-rules": "node scripts/check-firebase-rules.mjs",
    "check:mobile-codegen": "node scripts/check-mobile-codegen.mjs",
    "android:build": "cd apps/mobile/android && ./gradlew :app:assembleDebug",
    "android:test": "cd apps/mobile/android && ./gradlew :app:testDebugUnitTest",
    "android:release": "cd apps/mobile/android && ./gradlew :app:bundleRelease",
    "ios:typecheck": "scripts/ios-typecheck.sh",
    "ios:test": "swift test --package-path apps/mobile/ios/TennisKit",
    "fixtures:mobile-contract": "pnpm --filter @tennis/shared build && node scripts/generate-mobile-contract-fixtures.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "firebase-admin": "^14.5.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.4",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "react-native-screens",
      "react-native-reanimated",
      "react-native-gesture-handler"
    ],
    "overrides": {
      "@expo/dom-webview": "^57.0.1",
      "fast-xml-builder": ">=1.2.0",
      "fast-uri": ">=3.1.2",
      "@babel/plugin-transform-modules-systemjs": ">=7.29.4",
      "@tennis/web>react": "18.2.0",
      "@tennis/web>react-dom": "18.2.0",
      "react-native": "0.86.2",
      "@babel/core": "^7.29.6",
      "@grpc/grpc-js": ">=1.14.4",
      "body-parser": ">=1.20.6",
      "brace-expansion": ">=5.0.12",
      "decode-uri-component": ">=0.5.0",
      "minimatch@3>brace-expansion": "^1.1.21",
      "fast-xml-parser": ">=5.7.0",
      "uuid": ">=11.1.1",
      "esbuild": ">=0.28.1",
      "form-data": ">=2.5.6",
      "joi": ">=18.2.6",
      "js-yaml": ">=5.4.1",
      "nanoid": ">=3.3.17",
      "postcss": ">=8.5.23",
      "protobufjs": ">=7.6.5",
      "qs": ">=6.16.0",
      "sharp": ">=0.35.4",
      "shell-quote": ">=1.9.0",
      "websocket-driver": ">=0.7.5",
      "ws": ">=8.21.0"
    }
  },
  "engines": {
    "node": "22",
    "pnpm": ">=9.15.4"
  }
}
