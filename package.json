{
  "name": "tennis-scoring",
  "private": true,
  "version": "1.0.3",
  "packageManager": "pnpm@9.15.5",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "test:shared": "pnpm --filter @tennis/shared test",
    "backfill:season-level": "node scripts/backfill-division-season-level.mjs --",
    "backfill:profiles": "node scripts/backfill-profiles.mjs --",
    "check:firebase-rules": "node scripts/check-firebase-rules.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^10.4.0",
    "firebase-admin": "^13.10.0",
    "prettier": "^3.2.0",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "react-native-screens",
      "react-native-reanimated",
      "react-native-gesture-handler"
    ],
    "overrides": {
      "fast-xml-builder": ">=1.2.0",
      "fast-uri": ">=3.1.2",
      "@babel/plugin-transform-modules-systemjs": ">=7.29.4",
      "@tennis/web>react": "18.2.0",
      "@tennis/web>react-dom": "18.2.0",
      "react-native": "0.83.1",
      "@babel/core": "^7.29.6",
      "@grpc/grpc-js": ">=1.14.4",
      "body-parser": ">=1.20.6",
      "brace-expansion": ">=5.0.9",
      "minimatch@3>brace-expansion": ">=1.1.18",
      "fast-xml-parser": ">=5.7.0",
      "uuid": ">=11.1.1",
      "esbuild": ">=0.28.1",
      "form-data": ">=2.5.6",
      "joi": ">=17.13.4",
      "js-yaml": ">=4.3.1",
      "nanoid": ">=3.3.17",
      "postcss": ">=8.5.23",
      "protobufjs": ">=7.6.5",
      "sharp": ">=0.35.0",
      "shell-quote": ">=1.9.0",
      "websocket-driver": ">=0.7.5",
      "ws": ">=8.21.0"
    }
  },
  "engines": {
    "node": "22",
    "pnpm": ">=9.15.4"
  }
}
