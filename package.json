{
  "name": "tennis-scoring",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.5",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "test:shared": "pnpm --filter @tennis/shared test",
    "backfill:season-level": "node scripts/backfill-division-season-level.mjs"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^6.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "prettier": "^3.2.0",
    "firebase": "^10.12.0"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "react-native-screens",
      "react-native-reanimated",
      "react-native-gesture-handler"
    ],
    "overrides": {
      "react": "18.2.0",
      "react-dom": "18.2.0",
      "fast-xml-builder": ">=1.2.0",
      "fast-uri": ">=3.1.2",
      "@babel/plugin-transform-modules-systemjs": ">=7.29.4"
    }
  },
  "engines": {
    "node": "22",
    "pnpm": ">=9.15.4"
  }
}
