{
  "name": "@tennis/firebase-functions",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @tennis/shared build && esbuild src/index.ts --bundle --platform=node --external:firebase-admin --external:firebase-admin/app --external:firebase-admin/firestore --external:firebase-admin/messaging --external:firebase-functions --external:firebase-functions/v2 --external:pdf-lib --outfile=lib/index.js --format=cjs",
    "dev": "tsc --watch",
    "serve": "firebase emulators:start --only functions,firestore,auth,storage",
    "deploy": "firebase deploy --only functions",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "build:targeted-deploy": "pnpm --filter @tennis/shared build && esbuild src/targetedDeployIndex.ts --bundle --platform=node --external:firebase-admin --external:firebase-admin/app --external:firebase-admin/firestore --external:firebase-admin/messaging --external:firebase-functions --external:firebase-functions/v2 --external:pdf-lib --outfile=lib/index.js --format=cjs",
    "test:rules": "npx firebase-tools emulators:exec --only firestore,storage \"node ./scripts/rules-smoke.mjs\""
  },
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@tennis/shared": "workspace:*",
    "typescript": "^7.0.2",
    "@types/node": "^26.1.2",
    "esbuild": "0.28.1"
  }
}
