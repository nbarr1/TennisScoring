rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isAuth() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function getUserDataById(uid) {
      // Authorization must use the private users doc because app roles/division membership are written there.
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function getUserData() {
      return getUserDataById(request.auth.uid);
    }

    function isAdmin() {
      return isAuth() && (getUserData().role == 'admin' || getUserData().role == 'app_developer');
    }

    function isAppDeveloper() {
      return isAuth() && getUserData().role == 'app_developer';
    }

    function isDivisionAffiliated(divisionId) {
      let userData = getUserData();
      return isAuth() && divisionId is string && divisionId.size() > 0 && (
        userData.get('divisionId', null) == divisionId ||
        (userData.get('divisionIds', []) is list && divisionId in userData.get('divisionIds', [])) ||
        (userData.get('membershipDivisionIds', []) is list && divisionId in userData.get('membershipDivisionIds', []))
      );
    }

    function isUserInDivisionRoster(divisionId, userId) {
      let division = get(/databases/$(database)/documents/divisions/$(divisionId)).data;
      let playerIds = division.playerIds is list ? division.playerIds : [];
      let leaderIds = division.leaderIds is list ? division.leaderIds : [];
      return userId in playerIds || userId in leaderIds;
    }

    function isDivisionRosterMember(divisionId) {
      return isAuth() && isUserInDivisionRoster(divisionId, request.auth.uid);
    }

    function isLeader(divisionId) {
      let division = get(/databases/$(database)/documents/divisions/$(divisionId)).data;
      let leaderIds = division.leaderIds is list ? division.leaderIds : [];
      return isAuth() && request.auth.uid in leaderIds;
    }

    // Members of one side of a match. Doubles matches carry both partners in
    // side1/side2; singles matches (and any doc written before those fields
    // existed) fall back to the flat player id.
    function sideOnePlayerIds(matchData) {
      return matchData.get('side1', {}).get('playerIds', [matchData.player1Id]);
    }

    function sideTwoPlayerIds(matchData) {
      return matchData.get('side2', {}).get('playerIds', [matchData.player2Id]);
    }

    // A doubles partner is a participant even though they are neither
    // player1Id nor player2Id, so playerIds is the authoritative roster.
    // (storage.rules already checks membership this way.)
    function isMatchParticipant(matchData) {
      return isAuth() && (
        request.auth.uid == matchData.player1Id ||
        request.auth.uid == matchData.player2Id ||
        request.auth.uid in matchData.get('playerIds', [])
      );
    }

    // True when the caller is on the side opposing the report's submitter, so a
    // submitter's own partner can never confirm their team's report.
    function isOpposingSideOfSubmitter(existing) {
      return existing.reportSubmission.submittedBy in sideOnePlayerIds(existing)
        ? request.auth.uid in sideTwoPlayerIds(existing)
        : request.auth.uid in sideOnePlayerIds(existing);
    }

    function isChannelParticipant(channelData) {
      return isAuth() && request.auth.uid in channelData.participantIds;
    }

    // ---------- Profiles (Public) ----------
    match /profiles/{userId} {
      // Fields the owning user may sync from their own users/{uid} doc via updateUserProfile().
      // role and divisionId are deliberately excluded: those only change through Cloud Functions
      // (invites, division management, ranking recalculation) or admin maintenance.
      function selfWritableProfileFields() {
        return ['id', 'displayName', 'avatarUrl', 'tutorialDone', 'updatedAt'];
      }

      // Single-document reads can afford the extra get() needed to check the target's
      // live users/{uid}.divisionId instead of this doc's own (stale) divisionId.
      allow get: if isAuth() && (
        isUser(userId) ||
        isAdmin() ||
        getUserDataById(userId).divisionId == getUserData().divisionId
      );
      // List queries (e.g. division roster/opponent search) must stay resolvable from the
      // queried document's own field plus the requester's cached identity, or Firestore
      // rejects the entire query outright once a get() on a document outside the query's own
      // filter is introduced. Division membership here can only be judged against this doc's
      // own (possibly stale) divisionId; profiles is a mostly-static public mirror so brief
      // staleness here is an accepted trade-off for list operations.
      allow list: if isAuth() && (
        isAdmin() ||
        resource.data.divisionId == getUserData().divisionId
      );
      // Profiles are primarily managed by Cloud Functions. Admin can write profiles directly
      // for maintenance. A user may also self-heal/sync their own profile doc (e.g. via
      // updateUserProfile(), which batches a users/{uid} write with this one) for the safe
      // fields above; divisionId must match their real division and role/divisionId can never
      // change through this path.
      allow create: if isAdmin() || (
        isUser(userId) &&
        request.resource.data.keys().hasOnly(selfWritableProfileFields().concat(['divisionId', 'role'])) &&
        request.resource.data.id == userId &&
        request.resource.data.get('divisionId', getUserData().divisionId) == getUserData().divisionId &&
        request.resource.data.get('role', getUserData().role) == getUserData().role
      );
      allow update: if isAdmin() || (
        isUser(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(selfWritableProfileFields()) &&
        request.resource.data.get('divisionId', null) == resource.data.get('divisionId', null) &&
        request.resource.data.get('role', null) == resource.data.get('role', null)
      );
      allow delete: if isAdmin();
    }

    // ---------- Users (Private) ----------
    match /users/{userId} {
      function editableUserFields() {
        return [
          'displayName',
          'phone',
          'avatarUrl',
          'contactPreferences',
          'availability',
          'tipsEnabled',
          'fcmTokens',
          'blockedUserIds',
          'updatedAt'
        ];
      }

      allow read: if isAuth() && (
        isUser(userId) ||
        isAdmin() ||
        isLeader(resource.data.divisionId)
      );
      allow create: if isUser(userId) &&
        request.resource.data.id == request.auth.uid &&
        request.resource.data.role == 'player' &&
        request.resource.data.divisionId == null;
      allow update: if isAdmin() || (
        isUser(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(editableUserFields()) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.divisionId == resource.data.divisionId
      );
      allow delete: if isAdmin();
    }

    // ---------- Divisions ----------
    match /divisions/{divisionId} {
      function divisionFields() {
        return ['name', 'inviteCode', 'leaderIds', 'playerIds', 'createdAt', 'updatedAt'];
      }

      allow read: if isAuth() && (
        isAdmin() ||
        isDivisionAffiliated(divisionId) ||
        isDivisionRosterMember(divisionId)
      );
      // Regular division creation goes through the createDivision Cloud Function.
      // App developers may still create division documents directly for maintenance.
      allow create: if isAppDeveloper() &&
        request.resource.data.keys().hasOnly(divisionFields()) &&
        request.resource.data.name is string &&
        request.resource.data.inviteCode is string &&
        request.resource.data.inviteCode.matches('^[A-Z2-9]{8}$') &&
        request.resource.data.leaderIds is list &&
        request.resource.data.playerIds is list;
      allow update: if (isLeader(divisionId) || isAdmin()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'leaderIds', 'playerIds', 'updatedAt']);
      allow delete: if isAdmin();

      // Division levels/flights are managed by Cloud Functions.
      match /levels/{levelId} {
        allow read: if isAuth() && (
          isAdmin() ||
          isLeader(divisionId) ||
          isDivisionAffiliated(divisionId) ||
          isDivisionRosterMember(divisionId)
        );
        allow write: if false;
      }

      // Season/level memberships are managed by Cloud Functions.
      match /memberships/{membershipId} {
        allow read: if isAuth() && (
          isAdmin() ||
          isLeader(divisionId) ||
          isDivisionAffiliated(divisionId) ||
          isDivisionRosterMember(divisionId)
        );
        allow write: if false;
      }

      // Rankings sub-collection (written by Cloud Functions)
      match /rankings/{userId} {
        allow read: if isAuth() && (
          isAdmin() ||
          isDivisionAffiliated(divisionId) ||
          isDivisionRosterMember(divisionId)
        );
        allow write: if false; // Cloud Functions only
      }

      // Doubles team standings, one doc per fixed partnership (Cloud Functions)
      match /doublesRankings/{teamId} {
        allow read: if isAuth() && (
          isAdmin() ||
          isDivisionAffiliated(divisionId) ||
          isDivisionRosterMember(divisionId)
        );
        allow write: if false; // Cloud Functions only
      }
    }

    // ---------- Matches ----------
    // Returns true when a participant is performing a valid match update.
    // Confirming or disputing a report is only allowed for the non-submitting player.
    // Split into one helper per update kind because Firestore rules cap the number
    // of `let` bindings a single function may declare (10); each helper below stays
    // under that cap while canUpdateMatch itself just ORs their results together.
    function isCancellationUpdate(existing, incoming, changed) {
      return incoming.status == 'cancelled' &&
        (existing.status == 'proposed' || existing.status == 'scheduled' || existing.status == 'in_progress') &&
        changed.hasOnly(['status']);
    }

    function isPostponeUpdate(existing, incoming, changed) {
      return existing.status == 'scheduled' && incoming.status == 'scheduled' &&
        changed.hasOnly(['scheduledAt']);
    }

    function isAcceptProposalUpdate(existing, incoming, changed) {
      return existing.status == 'proposed' && incoming.status == 'scheduled' &&
        request.auth.uid in sideTwoPlayerIds(existing) &&
        changed.hasOnly(['status']);
    }

    function isStartMatchUpdate(existing, incoming, changed) {
      return existing.status == 'scheduled' && incoming.status == 'in_progress' &&
        changed.hasOnly(['status', 'startedAt', 'currentSetStartedAt', 'advancedStatsEnabled', 'liveScore']);
    }

    function isUndoUpdate(existing, incoming, changed) {
      return 'undoSnapshot' in existing &&
        incoming.liveScore == existing.undoSnapshot.liveScore &&
        incoming.status == existing.undoSnapshot.status &&
        changed.hasOnly(['status', 'liveScore', 'stats', 'winner', 'completedAt', 'currentSetStartedAt', 'matchDurationMs', 'undoSnapshot']);
    }

    function isReportSubmitUpdate(existing, incoming, changed) {
      return existing.status == 'pending_report' &&
        incoming.status == existing.status &&
        changed.hasOnly(['reportSubmission']) &&
        incoming.reportSubmission.keys().hasOnly(['submittedBy', 'submittedAt', 'status']) &&
        incoming.reportSubmission.submittedBy == request.auth.uid &&
        incoming.reportSubmission.submittedAt is number &&
        incoming.reportSubmission.status == 'pending_confirmation';
    }

    function isValidConfirmOrDisputeUpdate(existing, incoming, changed) {
      let toCompleted = incoming.status == 'completed' && existing.status == 'pending_report';
      let toDisputed  = incoming.status == 'disputed'  && existing.status == 'pending_report';
      let isConfirmOrDispute = toCompleted || toDisputed;
      let hasSubmission = 'reportSubmission' in existing;
      let isNotSubmitter = hasSubmission &&
        request.auth.uid != existing.reportSubmission.submittedBy &&
        isOpposingSideOfSubmitter(existing);
      let preservesOriginalSubmission = hasSubmission &&
        incoming.reportSubmission.submittedBy == existing.reportSubmission.submittedBy &&
        incoming.reportSubmission.submittedAt == existing.reportSubmission.submittedAt;
      let isValidConfirm = toCompleted &&
        incoming.reportSubmission.keys().hasOnly(['submittedBy', 'submittedAt', 'status', 'confirmedBy', 'confirmedAt']) &&
        incoming.reportSubmission.status == 'confirmed' &&
        incoming.reportSubmission.confirmedBy == request.auth.uid &&
        incoming.reportSubmission.confirmedAt is number;
      let isValidDispute = toDisputed &&
        incoming.reportSubmission.keys().hasOnly(['submittedBy', 'submittedAt', 'status', 'disputedBy', 'disputedAt']) &&
        incoming.reportSubmission.status == 'disputed' &&
        incoming.reportSubmission.disputedBy == request.auth.uid &&
        incoming.reportSubmission.disputedAt is number;
      return isConfirmOrDispute &&
        hasSubmission &&
        existing.reportSubmission.status == 'pending_confirmation' &&
        isNotSubmitter &&
        preservesOriginalSubmission &&
        changed.hasOnly(['status', 'reportSubmission']) &&
        (isValidConfirm || isValidDispute);
    }

    function isGuestFinalizeUpdate(existing, incoming, changed) {
      let isGuestMatch = existing.get('player2IsGuest', false) == true;
      let toCompleted = incoming.status == 'completed' && existing.status == 'pending_report';
      return isGuestMatch && toCompleted &&
        changed.hasOnly(['status', 'completedAt', 'reportSubmission']) &&
        incoming.reportSubmission.keys().hasOnly(['submittedBy', 'submittedAt', 'status', 'confirmedBy', 'confirmedAt']) &&
        incoming.reportSubmission.submittedBy == request.auth.uid &&
        incoming.reportSubmission.submittedAt is number &&
        incoming.reportSubmission.status == 'confirmed' &&
        incoming.reportSubmission.confirmedBy == request.auth.uid &&
        incoming.reportSubmission.confirmedAt is number;
    }

    function isLinkGuestUpdate(existing, incoming, changed) {
      return existing.get('player2IsGuest', false) == true &&
        incoming.player2IsGuest == false &&
        changed.hasOnly(['player2Id', 'player2Name', 'player2IsGuest', 'playerIds']);
    }

    // A score edit reopens the match for re-confirmation. It must CLEAR any existing
    // reportSubmission rather than write a new one: allowing the editor to author the
    // submission block lets them name the opponent as `submittedBy`, which makes the
    // editor a valid non-submitter under isValidConfirmOrDisputeUpdate and lets a single
    // player confirm their own rewritten score straight to 'completed' (and into the
    // division standings). Forcing the field to be deleted means the editor must re-submit
    // via isReportSubmitUpdate — which pins submittedBy to their own uid — and the opponent
    // remains the only party who can confirm.
    function isEditScoreUpdate(existing, incoming, changed) {
      return existing.status in ['pending_report', 'completed'] &&
        incoming.status == 'pending_report' &&
        !('reportSubmission' in incoming) &&
        !('undoSnapshot' in incoming) &&
        changed.hasOnly(['liveScore', 'winner', 'status', 'completedAt', 'reportSubmission', 'undoSnapshot']);
    }

    function canUpdateMatch(existing, incoming) {
      let isParticipant = isMatchParticipant(existing);
      let changed = incoming.diff(existing).affectedKeys();
      return isParticipant && (
        isCancellationUpdate(existing, incoming, changed) ||
        isPostponeUpdate(existing, incoming, changed) ||
        isAcceptProposalUpdate(existing, incoming, changed) ||
        isStartMatchUpdate(existing, incoming, changed) ||
        isUndoUpdate(existing, incoming, changed) ||
        isReportSubmitUpdate(existing, incoming, changed) ||
        isGuestFinalizeUpdate(existing, incoming, changed) ||
        isLinkGuestUpdate(existing, incoming, changed) ||
        isEditScoreUpdate(existing, incoming, changed) ||
        isValidConfirmOrDisputeUpdate(existing, incoming, changed)
      );
    }

    match /matches/{matchId} {
      function matchFields() {
        return [
          'divisionId',
          'seasonId',
          'divisionLevelId',
          'matchType',
          'side1',
          'side2',
          'player1Id',
          'player2Id',
          'player1Name',
          'player2Name',
          'player2IsGuest',
          'playerIds',
          'format',
          'status',
          'liveScore',
          'stats',
          'advancedStatsEnabled',
          'currentSetStartedAt',
          'matchDurationMs',
          'reportSubmission',
          'winner',
          'reportUrl',
          'tipsEnabled',
          'undoSnapshot',
          'source',
          'isDivisionMatch',
          'createdBy',
          'scheduledAt',
          'startedAt',
          'completedAt',
          'createdAt'
        ];
      }

      allow read: if isAuth() && (
        isAdmin() ||
        isDivisionAffiliated(resource.data.divisionId) ||
        isDivisionRosterMember(resource.data.divisionId) ||
        isMatchParticipant(resource.data) ||
        isLeader(resource.data.divisionId)
      );
      allow create: if isAuth() &&
        request.resource.data.keys().hasOnly(matchFields()) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.player1Id == request.auth.uid &&
        request.resource.data.status in ['scheduled', 'proposed'] &&
        (
          isDivisionAffiliated(request.resource.data.divisionId) ||
          isDivisionRosterMember(request.resource.data.divisionId)
        ) &&
        (
          (
            request.resource.data.get('player2IsGuest', false) == true &&
            request.resource.data.playerIds == [request.auth.uid]
          ) ||
          (
            request.resource.data.playerIds == [request.auth.uid, request.resource.data.player2Id] &&
            (
              getUserDataById(request.resource.data.player2Id).divisionId == request.resource.data.divisionId ||
              isUserInDivisionRoster(request.resource.data.divisionId, request.resource.data.player2Id)
            )
          )
        );
      allow update: if isAdmin() || isLeader(resource.data.divisionId) || canUpdateMatch(resource.data, request.resource.data);
      allow delete: if isAdmin() || isLeader(resource.data.divisionId) || (
        isMatchParticipant(resource.data) &&
        resource.data.createdBy == request.auth.uid &&
        resource.data.status in ['proposed', 'scheduled']
      );

      // Score actions sub-collection
      match /actions/{actionId} {
        function actionFields() {
          return ['type', 'player', 'scorer', 'score', 'snapshot', 'metadata', 'createdBy', 'createdAt'];
        }

        function validActionCreate() {
          return request.resource.data.keys().hasOnly(actionFields()) &&
            request.resource.data.createdBy == request.auth.uid &&
            request.resource.data.createdAt is number &&
            request.resource.data.type is string;
        }

        allow read: if isAuth() &&
          isMatchParticipant(get(/databases/$(database)/documents/matches/$(matchId)).data);
        allow create: if isMatchParticipant(get(/databases/$(database)/documents/matches/$(matchId)).data) &&
          validActionCreate();
        allow update, delete: if false;
      }
    }

    // ---------- Head-to-head ----------
    match /headToHead/{h2hId} {
      allow read: if isAuth() && (
        isAdmin() ||
        isDivisionAffiliated(resource.data.divisionId) ||
        isDivisionRosterMember(resource.data.divisionId)
      );
      allow write: if false; // Cloud Functions only
    }



    // ---------- Feedback ----------
    // Feedback is submitted through the submitFeedback Cloud Function and stored
    // only as GitHub issues; no client Firestore access is allowed.
    match /feedback/{feedbackId} {
      allow read, write: if false;
    }

    // ---------- Invites ----------
    match /invites/{inviteId} {
      allow read, write: if false; // Accessed only through Cloud Functions
    }

    // Optional Firebase Trigger Email extension queue
    match /mail/{mailId} {
      allow read, write: if false; // Cloud Functions / extension only
    }


    // ---------- Channels ----------
    match /channels/{channelId} {
      function validDirectChannelCreate() {
        return request.resource.data.keys().hasOnly(['type', 'participantIds', 'createdAt']) &&
          request.resource.data.type == 'direct' &&
          request.resource.data.participantIds.size() == 2 &&
          request.auth.uid in request.resource.data.participantIds &&
          getUserDataById(request.resource.data.participantIds[0]).divisionId == getUserData().divisionId &&
          getUserDataById(request.resource.data.participantIds[1]).divisionId == getUserData().divisionId;
      }

      allow read: if isChannelParticipant(resource.data);
      allow create: if isAuth() && validDirectChannelCreate();
      allow update: if false;
      allow delete: if isAuth() && resource.data.type == 'direct' && isChannelParticipant(resource.data);

      match /messages/{messageId} {
        allow read: if isChannelParticipant(get(/databases/$(database)/documents/channels/$(channelId)).data);
        allow create: if isAuth() &&
          isChannelParticipant(get(/databases/$(database)/documents/channels/$(channelId)).data) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.readBy == [request.auth.uid] &&
          request.resource.data.keys().hasOnly([
            'channelId',
            'senderId',
            'senderName',
            'content',
            'type',
            'sharedContact',
            'readBy',
            'createdAt'
          ]);
        allow update: if isAuth() &&
          isChannelParticipant(get(/databases/$(database)/documents/channels/$(channelId)).data) &&
          request.auth.uid in request.resource.data.readBy &&
          request.resource.data.readBy.hasAll(resource.data.readBy) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
        // Direct-channel participants may delete their own conversation's messages;
        // division leaders/admins may additionally remove a reported message from
        // their division's group channel as part of UGC moderation.
        allow delete: if isAuth() && (
          (
            get(/databases/$(database)/documents/channels/$(channelId)).data.type == 'direct' &&
            isChannelParticipant(get(/databases/$(database)/documents/channels/$(channelId)).data)
          ) ||
          (
            get(/databases/$(database)/documents/channels/$(channelId)).data.get('divisionId', null) != null &&
            (
              isAdmin() ||
              isLeader(get(/databases/$(database)/documents/channels/$(channelId)).data.divisionId)
            )
          )
        );
      }
    }

    // ---------- Message reports (UGC moderation) ----------
    match /messageReports/{reportId} {
      function reportFields() {
        return [
          'channelId',
          'messageId',
          'messageContent',
          'messageSenderId',
          'messageSenderName',
          'reportedBy',
          'reason',
          'note',
          'status',
          'divisionId',
          'createdAt'
        ];
      }

      allow read: if isAuth() && (
        isAdmin() ||
        isLeader(resource.data.get('divisionId', ''))
      );
      allow create: if isAuth() &&
        request.resource.data.keys().hasOnly(reportFields()) &&
        request.resource.data.reportedBy == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.reason in ['harassment', 'spam', 'inappropriate', 'other'] &&
        request.resource.data.divisionId is string &&
        request.resource.data.divisionId.size() > 0 &&
        request.resource.data.createdAt is number;
      allow update: if isAuth() &&
        (isAdmin() || isLeader(resource.data.get('divisionId', ''))) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedBy', 'resolvedAt']) &&
        request.resource.data.status in ['dismissed', 'removed'] &&
        request.resource.data.resolvedBy == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}
