rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isAuth() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuth() && (getUserData().role == 'admin' || getUserData().role == 'app_developer');
    }

    function isAppDeveloper() {
      return isAuth() && getUserData().role == 'app_developer';
    }

    function isDivisionMember(divisionId) {
      return isAuth() && getUserData().divisionId == divisionId;
    }

    function isUserInDivisionRoster(divisionId, userId) {
      let division = get(/databases/$(database)/documents/divisions/$(divisionId)).data;
      let playerIds = division.playerIds is list ? division.playerIds : [];
      let leaderIds = division.leaderIds is list ? division.leaderIds : [];
      return userId in playerIds || userId in leaderIds;
    }

    function isDivisionRosterMember(divisionId) {
      return isAuth() && isUserInDivisionRoster(divisionId, request.auth.uid);
    }


    function hasDivisionLevelMembership(divisionId, seasonId, divisionLevelId) {
      return isAuth() && exists(
        /databases/$(database)/documents/divisions/$(divisionId)/memberships/$(seasonId + '_' + divisionLevelId + '_' + request.auth.uid)
      );
    }

    function isLeader(divisionId) {
      let division = get(/databases/$(database)/documents/divisions/$(divisionId)).data;
      let leaderIds = division.leaderIds is list ? division.leaderIds : [];
      return isAuth() && request.auth.uid in leaderIds;
    }

    function isMatchParticipant(matchData) {
      return isAuth() && (
        request.auth.uid == matchData.player1Id ||
        request.auth.uid == matchData.player2Id
      );
    }

    function isChannelParticipant(channelData) {
      return isAuth() && request.auth.uid in channelData.participantIds;
    }

    // ---------- Users ----------
    match /users/{userId} {
      function editableUserFields() {
        return [
          'displayName',
          'phone',
          'avatarUrl',
          'contactPreferences',
          'availability',
          'tipsEnabled',
          'fcmTokens',
          'updatedAt'
        ];
      }

      allow read: if isAuth() && (
        isUser(userId) ||
        isAdmin() ||
        resource.data.divisionId == getUserData().divisionId
      );
      allow create: if isUser(userId) &&
        request.resource.data.id == request.auth.uid &&
        request.resource.data.role == 'player' &&
        request.resource.data.divisionId == null;
      allow update: if isAdmin() || (
        isUser(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(editableUserFields()) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.divisionId == resource.data.divisionId
      );
      allow delete: if isAdmin();
    }

    // ---------- Divisions ----------
    match /divisions/{divisionId} {
      function divisionFields() {
        return ['name', 'inviteCode', 'leaderIds', 'playerIds', 'createdAt', 'updatedAt'];
      }

      allow read: if isAuth() && (
        isAdmin() ||
        isDivisionMember(divisionId) ||
        isDivisionRosterMember(divisionId)
      );
      // Regular division creation goes through the createDivision Cloud Function.
      // App developers may still create division documents directly for maintenance.
      allow create: if isAppDeveloper() &&
        request.resource.data.keys().hasOnly(divisionFields()) &&
        request.resource.data.name is string &&
        request.resource.data.inviteCode is string &&
        request.resource.data.inviteCode.matches('^[A-Z2-9]{8}$') &&
        request.resource.data.leaderIds is list &&
        request.resource.data.playerIds is list;
      allow update: if (isLeader(divisionId) || isAdmin()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'leaderIds', 'playerIds', 'updatedAt']);
      allow delete: if isAdmin();

      // Division levels/flights are managed by Cloud Functions.
      match /levels/{levelId} {
        allow read: if isAuth() && (
          isAdmin() ||
          isDivisionMember(divisionId) ||
          isDivisionRosterMember(divisionId) ||
          hasDivisionLevelMembership(divisionId, resource.data.seasonId, levelId)
        );
        allow write: if false;
      }

      // Season/level memberships are managed by Cloud Functions.
      match /memberships/{membershipId} {
        allow read: if isAuth() && (
          isAdmin() ||
          isLeader(divisionId) ||
          isDivisionMember(divisionId) ||
          isDivisionRosterMember(divisionId)
        );
        allow write: if false;
      }

      // Rankings sub-collection (written by Cloud Functions)
      match /rankings/{userId} {
        allow read: if isAuth() && (
          isAdmin() ||
          isDivisionMember(divisionId) ||
          isDivisionRosterMember(divisionId)
        );
        allow write: if false; // Cloud Functions only
      }
    }

    // ---------- Matches ----------
    // Returns true when a participant is performing a valid match update.
    // Confirming or disputing a report is only allowed for the non-submitting player.
    function canUpdateMatch(existing, incoming) {
      let isParticipant = isMatchParticipant(existing);
      let changed = incoming.diff(existing).affectedKeys();
      let isCancellation = incoming.status == 'cancelled' &&
        (existing.status == 'proposed' || existing.status == 'scheduled' || existing.status == 'in_progress') &&
        changed.hasOnly(['status']);
      let isPostpone = existing.status == 'scheduled' && incoming.status == 'scheduled' &&
        changed.hasOnly(['scheduledAt']);
      let isAcceptProposal = existing.status == 'proposed' && incoming.status == 'scheduled' &&
        request.auth.uid == existing.player2Id &&
        changed.hasOnly(['status']);
      let isStartMatch = existing.status == 'scheduled' && incoming.status == 'in_progress' &&
        changed.hasOnly(['status', 'startedAt', 'currentSetStartedAt', 'advancedStatsEnabled', 'liveScore']);
      let isUndo = 'undoSnapshot' in existing &&
        incoming.liveScore == existing.undoSnapshot.liveScore &&
        incoming.status == existing.undoSnapshot.status &&
        changed.hasOnly(['status', 'liveScore', 'stats', 'winner', 'completedAt', 'currentSetStartedAt', 'matchDurationMs', 'undoSnapshot']);
      let isReportSubmit = existing.status == 'pending_report' &&
        incoming.status == existing.status &&
        changed.hasOnly(['reportSubmission']) &&
        incoming.reportSubmission.keys().hasOnly(['submittedBy', 'submittedAt', 'status']) &&
        incoming.reportSubmission.submittedBy == request.auth.uid &&
        incoming.reportSubmission.submittedAt is number &&
        incoming.reportSubmission.status == 'pending_confirmation';
      let toCompleted = incoming.status == 'completed' && existing.status == 'pending_report';
      let toDisputed  = incoming.status == 'disputed'  && existing.status == 'pending_report';
      let isConfirmOrDispute = toCompleted || toDisputed;
      let hasSubmission = 'reportSubmission' in existing;
      let isNotSubmitter = hasSubmission && request.auth.uid != existing.reportSubmission.submittedBy;
      let preservesOriginalSubmission = hasSubmission &&
        incoming.reportSubmission.submittedBy == existing.reportSubmission.submittedBy &&
        incoming.reportSubmission.submittedAt == existing.reportSubmission.submittedAt;
      let isValidConfirm = toCompleted &&
        incoming.reportSubmission.keys().hasOnly(['submittedBy', 'submittedAt', 'status', 'confirmedBy', 'confirmedAt']) &&
        incoming.reportSubmission.status == 'confirmed' &&
        incoming.reportSubmission.confirmedBy == request.auth.uid &&
        incoming.reportSubmission.confirmedAt is number;
      let isValidDispute = toDisputed &&
        incoming.reportSubmission.keys().hasOnly(['submittedBy', 'submittedAt', 'status', 'disputedBy', 'disputedAt']) &&
        incoming.reportSubmission.status == 'disputed' &&
        incoming.reportSubmission.disputedBy == request.auth.uid &&
        incoming.reportSubmission.disputedAt is number;
      let isValidConfirmOrDispute = isConfirmOrDispute &&
        hasSubmission &&
        existing.reportSubmission.status == 'pending_confirmation' &&
        isNotSubmitter &&
        preservesOriginalSubmission &&
        changed.hasOnly(['status', 'reportSubmission']) &&
        (isValidConfirm || isValidDispute);
      let isGuestMatch = existing.get('player2IsGuest', false) == true;
      let isGuestFinalize = isGuestMatch && toCompleted &&
        changed.hasOnly(['status', 'completedAt', 'reportSubmission']) &&
        incoming.reportSubmission.keys().hasOnly(['submittedBy', 'submittedAt', 'status', 'confirmedBy', 'confirmedAt']) &&
        incoming.reportSubmission.submittedBy == request.auth.uid &&
        incoming.reportSubmission.submittedAt is number &&
        incoming.reportSubmission.status == 'confirmed' &&
        incoming.reportSubmission.confirmedBy == request.auth.uid &&
        incoming.reportSubmission.confirmedAt is number;
      let isLinkGuest = existing.get('player2IsGuest', false) == true &&
        incoming.player2IsGuest == false &&
        changed.hasOnly(['player2Id', 'player2Name', 'player2IsGuest', 'playerIds']);
      let isEditScore = existing.status in ['pending_report', 'completed'] &&
        incoming.status == 'pending_report' &&
        changed.hasOnly(['liveScore', 'winner', 'status', 'completedAt', 'reportSubmission', 'undoSnapshot']);
      return isParticipant && (
        isCancellation ||
        isPostpone ||
        isAcceptProposal ||
        isStartMatch ||
        isUndo ||
        isReportSubmit ||
        isGuestFinalize ||
        isLinkGuest ||
        isEditScore ||
        isValidConfirmOrDispute
      );
    }

    match /matches/{matchId} {
      function matchFields() {
        return [
          'divisionId',
          'seasonId',
          'divisionLevelId',
          'matchType',
          'side1',
          'side2',
          'player1Id',
          'player2Id',
          'player1Name',
          'player2Name',
          'player2IsGuest',
          'playerIds',
          'format',
          'status',
          'liveScore',
          'stats',
          'advancedStatsEnabled',
          'currentSetStartedAt',
          'matchDurationMs',
          'reportSubmission',
          'winner',
          'reportUrl',
          'tipsEnabled',
          'undoSnapshot',
          'source',
          'isDivisionMatch',
          'createdBy',
          'scheduledAt',
          'startedAt',
          'completedAt',
          'createdAt'
        ];
      }

      allow read: if isAuth() && (
        isAdmin() ||
        isDivisionMember(resource.data.divisionId) ||
        isDivisionRosterMember(resource.data.divisionId) ||
        isMatchParticipant(resource.data) ||
        isLeader(resource.data.divisionId)
      );
      allow create: if isAuth() &&
        request.resource.data.keys().hasOnly(matchFields()) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.player1Id == request.auth.uid &&
        request.resource.data.status in ['scheduled', 'proposed'] &&
        (
          isDivisionMember(request.resource.data.divisionId) ||
          isDivisionRosterMember(request.resource.data.divisionId)
        ) &&
        (
          (
            request.resource.data.get('player2IsGuest', false) == true &&
            request.resource.data.playerIds == [request.auth.uid]
          ) ||
          (
            request.resource.data.playerIds == [request.auth.uid, request.resource.data.player2Id] &&
            (
              get(/databases/$(database)/documents/users/$(request.resource.data.player2Id)).data.divisionId == request.resource.data.divisionId ||
              isUserInDivisionRoster(request.resource.data.divisionId, request.resource.data.player2Id)
            )
          )
        );
      allow update: if isAdmin() || isLeader(resource.data.divisionId) || canUpdateMatch(resource.data, request.resource.data);
      allow delete: if isAdmin() || isLeader(resource.data.divisionId) || (
        isMatchParticipant(resource.data) &&
        resource.data.createdBy == request.auth.uid &&
        resource.data.status in ['proposed', 'scheduled']
      );

      // Score actions sub-collection
      match /actions/{actionId} {
        function actionFields() {
          return ['type', 'player', 'scorer', 'score', 'snapshot', 'metadata', 'createdBy', 'createdAt'];
        }

        function validActionCreate() {
          return request.resource.data.keys().hasOnly(actionFields()) &&
            request.resource.data.createdBy == request.auth.uid &&
            request.resource.data.createdAt is number &&
            request.resource.data.type is string;
        }

        allow read: if isAuth() &&
          isMatchParticipant(get(/databases/$(database)/documents/matches/$(matchId)).data);
        allow create: if isMatchParticipant(get(/databases/$(database)/documents/matches/$(matchId)).data) &&
          validActionCreate();
        allow update, delete: if false;
      }
    }

    // ---------- Head-to-head ----------
    match /headToHead/{h2hId} {
      allow read: if isAuth() && (
        isAdmin() ||
        isDivisionMember(resource.data.divisionId) ||
        isDivisionRosterMember(resource.data.divisionId)
      );
      allow write: if false; // Cloud Functions only
    }



    // ---------- Feedback ----------
    // Feedback is submitted through the submitFeedback Cloud Function and stored
    // only as GitHub issues; no client Firestore access is allowed.
    match /feedback/{feedbackId} {
      allow read, write: if false;
    }

    // ---------- Invites ----------
    match /invites/{inviteId} {
      allow read, write: if false; // Accessed only through Cloud Functions
    }

    // Optional Firebase Trigger Email extension queue
    match /mail/{mailId} {
      allow read, write: if false; // Cloud Functions / extension only
    }


    // ---------- Channels ----------
    match /channels/{channelId} {
      function validDirectChannelCreate() {
        return request.resource.data.keys().hasOnly(['type', 'participantIds', 'createdAt']) &&
          request.resource.data.type == 'direct' &&
          request.resource.data.participantIds.size() == 2 &&
          request.auth.uid in request.resource.data.participantIds &&
          get(/databases/$(database)/documents/users/$(request.resource.data.participantIds[0])).data.divisionId == getUserData().divisionId &&
          get(/databases/$(database)/documents/users/$(request.resource.data.participantIds[1])).data.divisionId == getUserData().divisionId;
      }

      allow read: if isChannelParticipant(resource.data);
      allow create: if isAuth() && validDirectChannelCreate();
      allow update: if false;
      allow delete: if isAuth() && resource.data.type == 'direct' && isChannelParticipant(resource.data);

      match /messages/{messageId} {
        allow read: if isChannelParticipant(get(/databases/$(database)/documents/channels/$(channelId)).data);
        allow create: if isAuth() &&
          isChannelParticipant(get(/databases/$(database)/documents/channels/$(channelId)).data) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.readBy == [request.auth.uid] &&
          request.resource.data.keys().hasOnly([
            'channelId',
            'senderId',
            'senderName',
            'content',
            'type',
            'sharedContact',
            'readBy',
            'createdAt'
          ]);
        allow update: if isAuth() &&
          isChannelParticipant(get(/databases/$(database)/documents/channels/$(channelId)).data) &&
          request.auth.uid in request.resource.data.readBy &&
          request.resource.data.readBy.hasAll(resource.data.readBy) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
        allow delete: if isAuth() &&
          get(/databases/$(database)/documents/channels/$(channelId)).data.type == 'direct' &&
          isChannelParticipant(get(/databases/$(database)/documents/channels/$(channelId)).data);
      }
    }
  }
}
