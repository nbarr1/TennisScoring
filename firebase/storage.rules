rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ---------- Helpers ----------
    function isAuth() {
      return request.auth != null;
    }

    function getUserData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuth() && (getUserData().role == 'admin' || getUserData().role == 'app_developer');
    }

    function isLeader(divisionId) {
      return isAuth() &&
        request.auth.uid in firestore.get(/databases/(default)/documents/divisions/$(divisionId)).data.leaderIds;
    }

    function matchData(matchId) {
      return firestore.get(/databases/(default)/documents/matches/$(matchId)).data;
    }

    function isMatchParticipant(matchDoc) {
      return isAuth() && (
        request.auth.uid == matchDoc.player1Id ||
        request.auth.uid == matchDoc.player2Id ||
        request.auth.uid in matchDoc.playerIds
      );
    }

    function canReadMatchReport(matchId) {
      let matchDoc = matchData(matchId);
      return isAdmin() || isLeader(matchDoc.divisionId) || isMatchParticipant(matchDoc);
    }

    // Avatar images — readable by all authenticated users, writable by owner
    match /avatars/{userId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024  // 5MB max
        && request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/gif',
          'image/webp'
        ];
    }

    // Match reports generated at reports/{matchId}.pdf are accessed through
    // signed URLs stored on the match document; direct client Storage reads are
    // denied because Storage rules cannot parse a suffixed wildcard segment.
    match /reports/{reportFile} {
      allow read, write: if false;
    }

    // Compile-safe authorized layout for future report objects.
    match /reports/{matchId}/{filename} {
      allow read: if filename == 'report.pdf' && canReadMatchReport(matchId);
      allow write: if false; // Cloud Functions use Admin SDK
    }
  }
}
