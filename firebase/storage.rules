rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Avatar images — readable by all authenticated users, writable by owner
    match /avatars/{userId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024  // 5MB max
        && request.resource.contentType.matches('image/.*');
    }

    // Match reports — readable by all authenticated users, writable by Cloud Functions only
    match /reports/{matchId}.pdf {
      allow read: if request.auth != null;
      allow write: if false; // Cloud Functions use Admin SDK
    }
  }
}
