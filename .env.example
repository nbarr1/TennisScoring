# Firebase
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# PingID / OIDC SSO
PINGID_ISSUER_URL=
PINGID_CLIENT_ID=
PINGID_CLIENT_SECRET=

# Web (Next.js)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Web push notifications (Firebase Cloud Messaging VAPID key)
# Get from Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin SDK (Cloud Functions / server-side)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
