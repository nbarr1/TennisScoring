# Firebase client config (copy to app-specific env files with the required public prefixes)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Web public Firebase config (apps/web/.env.local)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Web push notifications (Firebase Console → Project Settings → Cloud Messaging → Web Push certificates)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Web session cookie / Next.js
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Firebase Admin SDK (web middleware / server-side code)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Cloud Functions params (set via firebase/.env.PROJECT_ID, Firebase params, or CI variables)
APP_BASE_URL=https://yourdomain.com
ALLOWED_EMAIL_DOMAIN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_API_URL=https://api.github.com
GITHUB_FEEDBACK_LABELS=feedback

# Cloud Functions secret storage only; do not expose this to web/mobile clients.
# Set with: firebase functions:secrets:set GITHUB_TOKEN
GITHUB_TOKEN=
