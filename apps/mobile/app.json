{
  "expo": {
    "name": "Tennis League",
    "slug": "tennis-scoring",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a472a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tennisleague.app",
      "buildNumber": "1",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a472a"
      },
      "package": "com.tennisleague.app",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      ["expo-notifications", {
        "icon": "./assets/adaptive-icon.png",
        "color": "#1a472a"
      }],
      ["expo-secure-store", { "faceIDPermission": "Allow Tennis League to use Face ID" }]
    ],
    "scheme": "tennisleague",
    "extra": {
      "eas": {
        "projectId": "02b81764-55e6-4425-853d-d88185341097"
      }
    }
  }
}
