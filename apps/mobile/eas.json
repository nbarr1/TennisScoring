{
  "cli": { "version": ">= 10.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "android": { "googleServicesFile": "$GOOGLE_SERVICES_JSON" },
      "env": {
        "APP_ENV": "development",
        "NODE_VERSION": "20.19.0",
        "PNPM_VERSION": "9.15.4"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk", "googleServicesFile": "$GOOGLE_SERVICES_JSON" },
      "env": {
        "APP_ENV": "preview",
        "NODE_VERSION": "20.19.0",
        "PNPM_VERSION": "9.15.4"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": { "googleServicesFile": "$GOOGLE_SERVICES_JSON" },
      "env": {
        "APP_ENV": "production",
        "NODE_VERSION": "20.19.0",
        "PNPM_VERSION": "9.15.4"
      }
    }
  }
}
