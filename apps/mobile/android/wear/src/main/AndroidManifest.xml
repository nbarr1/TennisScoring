<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-feature android:name="android.hardware.type.watch" android:required="true" />
  <!-- Ambient mode holds a wake lock while the dimmed scoreboard stays up. -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <application
    android:allowBackup="false"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:theme="@style/WatchTheme">
    <!--
      Not standalone: the watch app has no network or account code of its own.
      Every score comes from the phone over the Data Layer and every command goes
      back the same way, so without the phone app it can only say "NO PHONE".
      Play lists a non-standalone app as needing its phone companion.
    -->
    <meta-data
      android:name="com.google.android.wearable.standalone"
      android:value="false" />
    <!--
      The Wear shared library behind ambient mode. Optional, so the app still
      installs on a watch without it, where the scoreboard just has no ambient view.
    -->
    <uses-library
      android:name="com.google.android.wearable"
      android:required="false" />
    <activity
      android:name=".MainActivity"
      android:launchMode="singleTask"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <!--
        Lets the phone open this app on the watch. RemoteActivityHelper can only
        deliver an ACTION_VIEW intent that carries a data URI and
        CATEGORY_BROWSABLE, so without a filter matching exactly that shape the
        intent resolves to nothing on the watch and the launch silently no-ops.
        The scheme matches expo.scheme in app.json; :app and :wear run on
        different devices, so sharing it resolves nothing ambiguously.

        singleTask above is part of the same feature: under the default launch
        mode a remote launch while the scoreboard is already open stacks a
        second copy of it instead of bringing the live one forward.
      -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="tennisleague" />
      </intent-filter>
    </activity>
  </application>
</manifest>
