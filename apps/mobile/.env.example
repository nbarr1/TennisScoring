# Firebase client config — all values from Firebase Console → Project Settings → General
# Prefix EXPO_PUBLIC_ makes them available in the Expo JS bundle at runtime.
# Copy this file to .env.local and fill in your values for local development.
# For EAS builds, set these as EAS environment variables:
#   eas env:create --name EXPO_PUBLIC_FIREBASE_API_KEY --value "your-value" --environment production

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
