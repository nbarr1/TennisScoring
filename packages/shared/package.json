{
  "name": "@tennis/shared",
  "version": "1.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ./scripts/tsup-build.mjs",
    "dev": "pnpm exec tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "tsup": "^8.0.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/node": "^26.4.1",
    "jest": "^30.5.1",
    "@types/jest": "^30.0.0",
    "ts-jest": "^29.4.12"
  }
}
